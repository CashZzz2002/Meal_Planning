# Neon writes real values to the git-ignored .env.local file.
# Run: neon env pull --file .env.local
DATABASE_URL=postgresql://user:password@pooled-host/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/neondb?sslmode=require&channel_binding=require
